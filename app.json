      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Allow Lift to use your location to find nearby rides."
      },
      "bundleIdentifier": "com.anonymous.lift-fe"
    },
    "android": {
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.rajputkamal.lift_fe"
    },
    "web": {
      "favicon": "./assets/logo_lift.png"
    },
    "extra": {
      "eas": {
        "projectId": "f5d84cbd-67e6-4ef5-8324-ba7910863e99"
      }
    }
  }
}
